{
  "name": "green-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler d1 migrations apply green-tracker --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply green-tracker --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.58.0",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  }
}
