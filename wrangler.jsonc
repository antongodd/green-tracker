{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "green-tracker",
  "account_id": "f8e8108b7cd94335e992d9569d41b48a",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "green-tracker",
      "database_id": "0cb063fc-ce0e-4f8f-a7b1-0354e47b325f",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "green-tracker-photos" }],
  // Passkeys are bound to this address (D11). Local dev overrides these in .dev.vars.
  "vars": {
    "RP_ID": "green-tracker.green-tracker.workers.dev",
    "ORIGIN": "https://green-tracker.green-tracker.workers.dev"
  },
  "observability": { "enabled": true },
  // The dev site (D47): only the owner can open it (a Cloudflare Access email lock), with its
  // own database and photos. Built with CLOUDFLARE_ENV=dev; deployed from the
  // dev branch. Bindings and vars aren't inherited, so each is listed again.
  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "green-tracker-dev",
          "database_id": "d4126bea-f68d-4c76-a44e-d5f802f4be3a",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "green-tracker-dev-photos" }],
      "vars": {
        "RP_ID": "green-tracker-dev.green-tracker.workers.dev",
        "ORIGIN": "https://green-tracker-dev.green-tracker.workers.dev",
        "SITE": "dev"
      }
    }
  }
}
