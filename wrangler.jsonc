{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "green-tracker",
  "account_id": "f8e8108b7cd94335e992d9569d41b48a",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "green-tracker",
      // Filled in when the production database is created (wrangler d1 create green-tracker).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "green-tracker-photos" }],
  "observability": { "enabled": true }
}
